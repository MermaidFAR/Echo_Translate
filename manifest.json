{
  "manifest_version": 3,
  "name": "Echo Translate · DeepSeek",
  "version": "0.1.1",
  "minimum_chrome_version": "120",
  "description": "使用自己的 DeepSeek API 翻译网页、选中文字、输入框、字幕、图片和文件。",
  "permissions": ["storage", "activeTab", "contextMenus", "sidePanel", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "background": {"service_worker": "src/background.js", "type": "module"},
  "action": {"default_popup": "pages/popup.html", "default_title": "Echo Translate"},
  "options_page": "pages/options.html",
  "side_panel": {"default_path": "pages/panel.html"},
  "commands": {
    "translate-page": {"suggested_key": {"default": "Alt+A"}, "description": "翻译或恢复网页"},
    "translate-input": {"suggested_key": {"default": "Alt+I"}, "description": "翻译当前输入框"},
    "toggle-hover": {"description": "启用或关闭按住 Alt 悬停翻译"},
    "open-panel": {"suggested_key": {"default": "Alt+S"}, "description": "打开翻译侧边栏"}
  },
  "content_scripts": [
    {"matches": ["<all_urls>"], "js": ["src/content.js"], "css": ["src/content.css"], "all_frames": true, "run_at": "document_idle"},
    {"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://www.youtube-nocookie.com/*"], "js": ["src/subtitle-bridge.js"], "world": "MAIN", "all_frames": true, "run_at": "document_start"}
  ],
  "web_accessible_resources": [{"resources": ["src/subtitles.js", "src/client.js", "src/settings.js"], "matches": ["<all_urls>"]}],
  "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; worker-src 'self'"}
}
